# Banco (Neon: use a connection string "pooled", com ?sslmode=require)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Auth.js — gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=
# Opcional: login com Google (deixe vazio para desativar)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# IA (apenas no servidor)
ANTHROPIC_API_KEY=
# Opcional: sobrescreve o modelo (padrão claude-haiku-5-5)
ANTHROPIC_MODEL=
# Limites diários por usuário (opcional)
AI_DAILY_NARRATION_LIMIT=40
AI_DAILY_SCOUT_LIMIT=60

# Stripe (modo teste)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# URL pública do app (usada nos redirects do Stripe)
APP_URL=http://localhost:3000
